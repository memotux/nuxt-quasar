{
  "name": "nuxt-quasar-vite",
  "version": "1.2.1",
  "description": "Quasar Framework UI for Nuxt",
  "keywords": [
    "module",
    "nuxt",
    "quasar",
    "ui",
    "vite"
  ],
  "homepage": "https://github.com/memotux/nuxt-quasar",
  "license": "MIT",
  "author": {
    "name": "Romeo Mendez Fuentes",
    "email": "romeo@mendezfuentes.net",
    "url": "https://romeo.mendezfuentes.net"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/memotux/nuxt-quasar.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "dev:generate": "nuxi generate playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
    "release": "pnpm run prepack && changelogen --release && pnpm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.1.0",
    "@nuxt/eslint-config": "^1.17.0",
    "@nuxt/kit": "^4.5.2",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/schema": "^4.5.2",
    "@nuxt/test-utils": "^4.2.0",
    "@quasar/extras": "^2.0.4",
    "@types/node": "latest",
    "baseline-browser-mapping": "^2.11.20",
    "changelogen": "^0.6.2",
    "eslint": "^10.9.1",
    "nuxt": "^4.5.2",
    "quasar": "^2.27.0",
    "sass-embedded": "^1.103.1",
    "typescript": "6",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "quasar": "^2.27.0",
    "sass-embedded": "^1.103.1"
  }
}
